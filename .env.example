# Email sender (required for Gmail)
FROM_EMAIL=finance@example.com
FROM_NAME=Your Company Name

# Test send recipient (required for send_k1s_gmail_test.js)
TEST_SEND_EMAIL=finance@example.com

# Encryption: use qpdf instead of PDFtk (optional; preserves fonts after redaction)
# Set to 1, true, or yes to use qpdf (brew install qpdf)
USE_QPDF=0

# Gmail OAuth credential paths (optional; defaults to project root)
# CREDENTIALS_PATH=credentials.json
# TOKEN_PATH=token.json

# Base folder for sensitive output (optional; defaults to ignore)
# IGNORE_FOLDER=ignore

# Redaction font path (optional)
FONT_PATH=fonts/CourierPrime-Regular.ttf
